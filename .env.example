# InH-Ticketing settings.
# Copy this file to `.env` and fill it in. `.env` is never committed to git.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# True on your PC only. Never True on the server.
DJANGO_DEBUG=True

# A long random value that signs sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Hostnames the app answers to, comma-separated.
# Server: helpdesk.mckennalabs.com (127.0.0.1 is added automatically there,
# for Docker's health check).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (with https://) for the server, comma-separated. Blank on your PC.
DJANGO_CSRF_TRUSTED_ORIGINS=

TIME_ZONE=America/Los_Angeles

# HTTPS hardening. Used only when DJANGO_DEBUG=False (the server); the
# defaults are right there, so normally leave these out.
#   DJANGO_SECURE_SSL_REDIRECT  Redirect plain HTTP to HTTPS. Default True;
#                               only False/0/no/off turns it off.
#   DJANGO_SECURE_HSTS_SECONDS  How long browsers must use HTTPS only (HSTS).
#                               Default 31536000 (one year). The proxy sends
#                               the same value. 0 tells browsers to forget it.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL blank on your PC to use a local SQLite file (db.sqlite3).
# Docker Compose sets it automatically from POSTGRES_PASSWORD below.
DATABASE_URL=

# Used by Docker Compose only. Letters and digits only, so it is safe in a URL:
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Microsoft 365 / Entra ID sign-in. Step-by-step: docs/entra-setup.md
# ---------------------------------------------------------------------------
# "Directory (tenant) ID": a GUID, not your domain name.
ENTRA_TENANT_ID=
# "Application (client) ID" of the app registration.
ENTRA_CLIENT_ID=
# The client secret's *Value* (not its Secret ID). Expires: put a reminder in your calendar.
ENTRA_CLIENT_SECRET=
# Must match a Web redirect URI on the app registration exactly.
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback

# The *Value* of each app role on the registration. Only change these if you
# named the roles differently. People with neither role are Requesters.
ENTRA_ROLE_AGENT=Agent
ENTRA_ROLE_ADMIN=Admin

# ---------------------------------------------------------------------------
# Email notifications. Step-by-step: docs/email-setup.md
# ---------------------------------------------------------------------------
# file    = write emails to tmp/emails/ (nothing is sent; the default)
# console = print emails in the worker's terminal
# graph   = send through Microsoft 365 from HELPDESK_MAILBOX
EMAIL_BACKEND=file
# The address people use to open the app (used for links in emails).
SITE_URL=http://localhost:8000
# The TEST shared mailbox emails are sent from, e.g. helpdesk-test@mckennalabs.com
HELPDESK_MAILBOX=
# Optional: where IT's "new request" alerts go (a distribution list or Teams channel address).
IT_NOTIFY_EMAIL=

# Email in: off = don't read the mailbox, graph = turn emails into tickets and replies.
INBOUND_EMAIL=off
# Only accept email from these domains (comma-separated). Blank = HELPDESK_MAILBOX's domain.
INBOUND_ALLOWED_DOMAINS=

# ===========================================================================
# PRODUCTION EXAMPLE: the server's .env, for reference.
# docs/deployment.md (section 5) creates it with fresh secrets; don't copy
# secrets from a PC. On the server: chmod 600 .env
# ===========================================================================
# # Docker Compose: always use both files; the name the proxy serves.
# COMPOSE_FILE=compose.yaml:compose.prod.yaml
# HELPDESK_HOSTNAME=helpdesk.mckennalabs.com
#
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<openssl rand -hex 32>
# DJANGO_ALLOWED_HOSTS=helpdesk.mckennalabs.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://helpdesk.mckennalabs.com
# TIME_ZONE=America/Los_Angeles
#
# # Hex only, so it is safe inside DATABASE_URL: openssl rand -hex 24
# POSTGRES_PASSWORD=<openssl rand -hex 24>
#
# ENTRA_TENANT_ID=<Directory (tenant) ID>
# ENTRA_CLIENT_ID=<Application (client) ID>
# ENTRA_CLIENT_SECRET=<the server's own client secret Value>
# ENTRA_REDIRECT_URI=https://helpdesk.mckennalabs.com/auth/callback
# ENTRA_ROLE_AGENT=Agent
# ENTRA_ROLE_ADMIN=Admin
#
# EMAIL_BACKEND=graph
# SITE_URL=https://helpdesk.mckennalabs.com
# # The TEST shared mailbox until the pilot ends (docs/email-setup.md).
# HELPDESK_MAILBOX=helpdesk-test@mckennalabs.com
# IT_NOTIFY_EMAIL=
# # Only ONE copy of the app may read a mailbox: turn this off on PCs.
# INBOUND_EMAIL=graph
# INBOUND_ALLOWED_DOMAINS=mckennalabs.com
